{
  "name": "@cognia/sync-protocol",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "Account Sync Protocol v1 (ADR-0215): the encoding, ids, registry rules, approval code and device proof that the Cognia client and the sync Worker share. Dependency-free; WebCrypto only.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "fixtures:generate:ops": "tsx scripts/generate-op-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
